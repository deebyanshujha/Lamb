class hello{
    init(name){
        this.name = name;
    }

    printName(){
        print this.name;
    }
}

class byebye < hello{
    init(name){
        this.name = name;
        super.init(name);
    }
    printName(){
        super.printName();
        print "bye bye" + this.name;
    }
}

var temp = byebye("deebyanshu");
temp.printName();